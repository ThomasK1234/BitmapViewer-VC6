/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\BitmapViewer.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File", ID_FILE_MRU_FILE1
    BEGIN
        MENUITEM "&New",                       ID_FILE_NEW
        MENUITEM "&Open...",                   ID_FILE_OPEN
        MENUITEM "&Save",                      ID_FILE_SAVE
        MENUITEM "Save &As...",                ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                ID_FILE_MRU_FILE1
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                      ID_APP_EXIT
    END
    POPUP "&Edit", ID_EDIT_MRU_FILE1
    BEGIN
        MENUITEM "&Undo",                      ID_EDIT_UNDO
        MENUITEM "&Redo",                      ID_EDIT_REDO
    END
    POPUP "&View", ID_VIEW_MRU_FILE1
    BEGIN
        MENUITEM "&Toolbar",                   ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                ID_VIEW_STATUS_BAR
    END
    POPUP "&Help", ID_HELP_MRU_FILE1
    BEGIN
        MENUITEM "&About BitmapViewer...",     ID_APP_ABOUT
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG 0, 0, 235, 159
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About BitmapViewer"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "BitmapViewer Version 1.0",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2026",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,14,WS_GROUP
    LTEXT           "Bitmap Viewer - VC6 MFC Application",IDC_STATIC,40,40,
                    150,8
    LTEXT           "Features:",IDC_STATIC,11,55,150,8
    LTEXT           "- Load and display bitmaps",IDC_STATIC,20,65,150,8
    LTEXT           "- Zoom with mouse wheel",IDC_STATIC,20,75,150,8
    LTEXT           "- Pan with right mouse button",IDC_STATIC,20,85,150,8
    LTEXT           "- Click detection on defined areas",IDC_STATIC,20,95,
                    150,8
END

/////////////////////////////////////////////////////////////////////////////
//
// STRINGTABLE
//

STRINGTABLE
BEGIN
    IDR_MAINFRAME           "Bitmap Viewer\nBitmapViewer\nBitmap Files (*.bmp)\n.bmp\nBitmapViewer.Document\nBitmapViewer Document"
END

/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

IDR_MAINFRAME TOOLBAR 16, 15
BEGIN
    BUTTON      ID_FILE_NEW
    BUTTON      ID_FILE_OPEN
    BUTTON      ID_FILE_SAVE
    SEPARATOR
    BUTTON      ID_EDIT_UNDO
    BUTTON      ID_EDIT_REDO
    SEPARATOR
    BUTTON      ID_APP_ABOUT
END

/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_MAINFRAME ACCELERATORS
BEGIN
    "N",            ID_FILE_NEW,            VIRTKEY, CONTROL
    "O",            ID_FILE_OPEN,           VIRTKEY, CONTROL
    "S",            ID_FILE_SAVE,           VIRTKEY, CONTROL
    "P",            ID_FILE_PRINT,          VIRTKEY, CONTROL
    "Z",            ID_EDIT_UNDO,           VIRTKEY, CONTROL
    "Y",            ID_EDIT_REDO,           VIRTKEY, CONTROL, SHIFT
END

